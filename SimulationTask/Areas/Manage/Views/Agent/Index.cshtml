@model List<User>

@{
    int count = 0;
}
<div class="container">
    <h1>Positions</h1>
    <a class="btn btn-primary" asp-controller="User" asp-action="Create">Create</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Id</th>
                <th scope="col">Name</th>

            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                count++;
                <tr>
                    <th scope="row">@count</th>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>
                        <div style="width:100px">
                            <img style="width:100%" src="~/Upload/Slider/@item.ImgUrl" />
                        </div>
                    </td>


                    <td>
                        <a class="btn btn-secondary" asp-action="Update" asp-route-Id="@item.Id">Update</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@item.Id">Delete</a>

                    </td>

                </tr>
            }

        </tbody>
    </table>
</div>